[Unit]
Description=Egg Esports Backend Service
Documentation=https://github.com/egg-esports
After=network.target mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/egg-esports

# 环境变量从 .env 文件加载（含 DB_PASSWORD、JWT_SECRET、各 API Key 等敏感配置）
EnvironmentFile=/opt/egg-esports/.env

# 启动参数：
#   --server.address=127.0.0.1  8088 仅监听本机，外网访问通过 nginx 反代
#   --spring.profiles.active=prod  生产配置
ExecStart=/usr/bin/java -Xms512m -Xmx1024m -jar /opt/egg-esports/egg-esports.jar \
    --server.address=127.0.0.1 \
    --spring.profiles.active=prod

# 停止时优雅关闭，等待 30 秒
KillSignal=SIGTERM
TimeoutStopSec=30

# 异常退出自动重启
Restart=on-failure
RestartSec=10

# 标准输出/错误重定向到 journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=egg-esports

[Install]
WantedBy=multi-user.target
