# ============================================================
# Egg Esports 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 不入库）
# 生产环境通过 systemd EnvironmentFile=/opt/egg-esports/.env 加载
# ============================================================

# ---- 数据库 ----
DB_PASSWORD=your_db_password

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password

# ---- JWT ----
# 至少 64 字符的随机字符串，可用 openssl rand -base64 48 生成
JWT_SECRET=your_jwt_secret_at_least_64_chars_long_change_me

# ---- 外部 API Key（免费 API） ----
GRID_API_KEY=your_grid_api_key
PANDASCORE_API_KEY=your_pandascore_api_key
RIOT_API_KEY=your_riot_api_key

# ---- CORS ----
EGG_CORS_ORIGINS=https://eggesports.com
