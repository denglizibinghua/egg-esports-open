# ============================================================
# Egg Esports 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 不入库）
# 生产环境通过 systemd EnvironmentFile=/opt/egg-esports/.env 加载
# Docker 部署通过 docker compose --env-file .env up -d 加载
# ============================================================

# ---- 数据库 ----
# 应用层使用的业务库密码（Docker 中 mysql 容器 MYSQL_USER=egg 的密码）
DB_PASSWORD=your_db_password
# Docker MySQL 容器 root 密码（仅 docker-compose 启动 MySQL 时使用，裸机部署可忽略）
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ---- Redis ----
# 裸机部署：填本机或远程 Redis 地址
# Docker 部署：docker-compose.yml 会自动覆盖为 redis（容器服务名），此处值被忽略
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
# 留空则 Redis 容器不启用认证（仅内网通信时可用）
# 生产环境建议设置一个非空密码

# ---- JWT ----
# 至少 64 字符的随机字符串，可用 openssl rand -base64 48 生成
JWT_SECRET=your_jwt_secret_at_least_64_chars_long_change_me

# ---- 外部 API Key（免费 API） ----
GRID_API_KEY=your_grid_api_key
PANDASCORE_API_KEY=your_pandascore_api_key
RIOT_API_KEY=your_riot_api_key

# ---- CORS ----
EGG_CORS_ORIGINS=https://eggesports.com
